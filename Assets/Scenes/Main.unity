  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Rupert
  leftTrigger: {fileID: 635887098}
  rightTrigger: {fileID: 1346129872}
  leftRay: {fileID: 1172479545}
  rightRay: {fileID: 1184410228}
  npcPanel: {fileID: 731481964}
  npcName: Rupert
  dialogueText: {fileID: 435566413}
  nameText: {fileID: 1908804939}
  dialogue:
  - Hello there, welcome to PawSign Village! We are so excited to have you here!
  - "I\u2019m Rupert, and I\u2019ll be your guide for getting settled into your new
    home."
  - Chat with our friendly villagers, to build your ASL skills, level up, and unlock
    new ways to personalize your world.
  - And if you ever get lost, come talk to me to get a hint for your next step.
  - Head over to Daisy to begin your first lesson!
  - Good luck!
