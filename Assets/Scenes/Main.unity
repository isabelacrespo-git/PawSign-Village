--- !u!114 &407581878
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 407581873}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 187664b406b15e24583a702547db1337, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Daisy
  leftTrigger: {fileID: 1518629502}
  rightTrigger: {fileID: 1522182315}
  leftRay: {fileID: 1172479545}
  rightRay: {fileID: 1184410228}
  npcPanel: {fileID: 731481964}
  npcName: Daisy
  dialogueText: {fileID: 435566413}
  nameText: {fileID: 1908804939}
  dialogue:
  - "Hi there, I\u2019m Daisy. It\u2019s so nice to meet you!"
  - "Let\u2019s begin your ASL learning journey with the alphabet."
  - Follow along while I sign the first 5 letters.
  - DEMONSTRATION
  - Now try it on your own.
  - SIGNING
  - "Yesss that was fantastic! Now let\u2019s move on to the next 5 letters."
  - DEMONSTRATION
  - "Now let\u2019s see what you remember."
  - SIGNING
  - Awesome job! Now let's do k through n.
  - DEMONSTRATION
  - Your turn!
  - SIGNING
  - Fantastic! Onto the next letters.
  - DEMONSTRATION
  - Give it a go!
  - SIGNING
  - Wow impressive! Let's continue.
  - DEMONSTRATION
  - Show me what you know!
  - SIGNING
  - Amazing! Now for the last 4 letters.
  - DEMONSTRATION
  - Now try it yourself!
  - SIGNING
  - Wow you're a natural!
  - "Before we finish, I don\u2019t think I caught your name yet! Try signing it
    to me!"
  - DEMONSTRATION
  - Now try it out!
  - SIGNING
  - Yay! Congrats on finishing your first lesson!
  - It was so nice to meet you! If you ever need a refresher on how to sign the alphabet
    again, I have a little note for you with the alphabet drawn! Good luck with learning
    ASL!
